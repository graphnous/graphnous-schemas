{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphnous.dev/schema/scan/scan-result.schema.json",
  "title": "GraphNous Scan Result",
  "description": "Result produced by a GraphNous scanner for a single scan target.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "target", "modules"],
  "properties": {
    "format": {
      "type": "string",
      "const": "graphnous-scan-result"
    },
    "version": {
      "type": "string",
      "const": "2"
    },
    "target": {
      "$ref": "#/$defs/ScanTarget"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Module"
      }
    }
  },
  "$defs": {
    "ScanTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "language", "languageVersion"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "enum": ["JAVA", "TYPESCRIPT", "JAVASCRIPT", "PYTHON", "GO", "RUST"]
        },
        "languageVersion": {
          "type": "string",
          "minLength": 1
        },
        "buildSystem": {
          "type": "string",
          "enum": ["MAVEN", "GRADLE", "NPM", "PNPM", "YARN"]
        },
        "buildSystemVersion": {
          "type": "string"
        }
      }
    },
    "Module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "files"],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/File"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Package"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          }
        }
      }
    },
    "File": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "sourceSet": {
          "description": "Whether the file is production code or test code, e.g. from src/main/java or src/test/java in Maven. Absent when the scanner cannot tell.",
          "type": "string",
          "enum": ["MAIN", "TEST"]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "type": "string"
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Class"
          }
        }
      }
    },
    "Package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualifiedName": {
          "type": "string"
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Class"
          }
        }
      }
    },
    "Class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "qualifiedName"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualifiedName": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["CLASS", "INTERFACE", "ENUM", "RECORD", "ANNOTATION"]
        },
        "modifiers": {
          "description": "The modifiers as declared in the source.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Modifier"
          }
        },
        "typeParameters": {
          "description": "The declared type parameters with their bounds, e.g. \"T extends java.lang.Comparable<T>\".",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "superClass": {
          "description": "The class it extends. Only for classes.",
          "$ref": "#/$defs/TypeRef"
        },
        "interfaces": {
          "description": "The interfaces it implements, or for an interface those it extends.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypeRef"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Method"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Annotation"
          }
        }
      }
    },
    "Method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "qualifiedName"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualifiedName": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "Whether this is a method or a constructor. A constructor has no return type.",
          "type": "string",
          "enum": ["METHOD", "CONSTRUCTOR"]
        },
        "modifiers": {
          "description": "The modifiers as declared in the source.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Modifier"
          }
        },
        "typeParameters": {
          "description": "The declared type parameters with their bounds, e.g. \"T extends java.lang.Comparable<T>\".",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "returnType": {
          "description": "The declared return type. Absent for constructors.",
          "$ref": "#/$defs/TypeRef"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Annotation"
          }
        },
        "calls": {
          "description": "The methods and constructors called from the body, one entry per call site. Calls inside lambdas and anonymous classes declared in the body belong to this method.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Call"
          }
        },
        "fieldAccesses": {
          "description": "The fields read or written by the body, one entry per access.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldAccess"
          }
        },
        "typeUses": {
          "description": "The types the body refers to other than through its calls and field accesses, such as local variables, casts and instanceof checks, one entry per use.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypeUse"
          }
        }
      }
    },
    "Parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/TypeRef"
        },
        "qualifiedName": {
          "description": "The qualified name of the method followed by the name of the parameter, e.g. \"com.example.Orders.find(java.lang.String).id\".",
          "type": "string"
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Annotation"
          }
        }
      }
    },
    "Field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/TypeRef"
        },
        "qualifiedName": {
          "type": "string"
        },
        "modifiers": {
          "description": "The modifiers as declared in the source.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Modifier"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Annotation"
          }
        }
      }
    },
    "TypeRef": {
      "description": "A type as declared, with the classes it refers to.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "description": "The type with qualified names and its type arguments, e.g. \"java.util.Map<java.lang.String, com.example.Order>[]\".",
          "type": "string",
          "minLength": 1
        },
        "references": {
          "description": "The qualified names of every class the type refers to, including through type arguments, bounds and array element types, e.g. [\"java.util.Map\", \"java.lang.String\", \"com.example.Order\"]. Primitive types and type variables are left out.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {
          "description": "The qualified name of the method or constructor called, as in Method.qualifiedName, e.g. \"com.example.OrderRepository.findById(java.lang.String)\".",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "METHOD for a method call, CONSTRUCTOR for new, this(...) and super(...), METHOD_REFERENCE for a method or constructor reference such as Order::getId.",
          "type": "string",
          "enum": ["METHOD", "CONSTRUCTOR", "METHOD_REFERENCE"]
        },
        "line": {
          "description": "The line the call, access or use is on, starting at 1.",
          "type": "integer",
          "minimum": 1
        },
        "resolved": {
          "description": "Whether the scanner resolved the target. When false, the target is the name as written in the source, e.g. because the library declaring it is not on the classpath.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "FieldAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "access"],
      "properties": {
        "target": {
          "description": "The qualified name of the field, as in Field.qualifiedName, e.g. \"com.example.Order.id\".",
          "type": "string",
          "minLength": 1
        },
        "access": {
          "description": "READ, WRITE, or READ_WRITE for compound assignments and increments such as count++.",
          "type": "string",
          "enum": ["READ", "WRITE", "READ_WRITE"]
        },
        "line": {
          "description": "The line the call, access or use is on, starting at 1.",
          "type": "integer",
          "minimum": 1
        },
        "resolved": {
          "description": "Whether the scanner resolved the target. When false, the target is the name as written in the source, e.g. because the library declaring it is not on the classpath.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "TypeUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "kind"],
      "properties": {
        "target": {
          "description": "The qualified name of the class used.",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "How the body uses the type. Types in the signature are in returnType and the parameters, and instantiations are CONSTRUCTOR calls.",
          "type": "string",
          "enum": [
            "LOCAL_VARIABLE",
            "CAST",
            "INSTANCEOF",
            "CLASS_LITERAL",
            "CATCH",
            "TYPE_ARGUMENT",
            "OTHER"
          ]
        },
        "line": {
          "description": "The line the call, access or use is on, starting at 1.",
          "type": "integer",
          "minimum": 1
        },
        "resolved": {
          "description": "Whether the scanner resolved the target. When false, the target is the name as written in the source, e.g. because the library declaring it is not on the classpath.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "Modifier": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "PROTECTED",
        "PRIVATE",
        "STATIC",
        "FINAL",
        "ABSTRACT",
        "DEFAULT",
        "SEALED",
        "NON_SEALED",
        "SYNCHRONIZED",
        "TRANSIENT",
        "VOLATILE",
        "NATIVE",
        "STRICTFP"
      ]
    },
    "Annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualifiedName": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      }
    }
  }
}
